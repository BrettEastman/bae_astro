---
// Server Side
import Social from "./Social.astro";

const socials = [
  { platform: "instagram", username: "brettaustineastman" },
  { platform: "linkedin", username: "in/brett-austin-eastman" },
  { platform: "github", username: "BrettEastman" },
];

---

<div
  class="bg-paper dark:bg-surfaceDark border-t border-line dark:border-lineDark p-8 text-primary40 dark:text-primary50 flex justify-center"
>
  <footer class="flex flex-col gap-2 text-sm">
    <div class="flex flex-row gap-6 justify-center">
      <a
        class="uppercase tracking-wider hover:text-accent duration-200"
        rel="noreferrer"
        target="_blank"
        href="https://github.com/BrettEastman/bae_astro">Source code</a
      >
      <a
        class="uppercase tracking-wider hover:text-accent duration-200"
        rel="noreferrer"
        target="_blank"
        href="https://www.bretteastman.dev/">Developer portfolio</a
      >
    </div>
    <div class="socials">
      {
        socials.map((social) => (
          <Social platform={social.platform} username={social.username} />
        ))
      }
    </div>
    <p id="copyright" class="mt-2 text-center"></p>
  </footer>
</div>

<script>
  // Client Side
  const copyright = document.getElementById("copyright");
  if (copyright) {
    copyright.innerHTML = `©${new Date().getFullYear()} Lost Lanes Publishing`;
  }
</script>
