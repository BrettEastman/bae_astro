---
// Server Side
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="max-w-5xl mx-auto mt-6 mb-10 px-2">
  <h2
    class="page-title font-display uppercase tracking-tight font-semibold text-4xl md:text-5xl text-ink dark:text-primary70"
  >
    {title}
  </h2>
</div>
