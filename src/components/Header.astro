---
import Navigation from "./Navigation.astro";
import Hamburger from "./Hamburger.astro";
---

<header class="max-w-6xl mx-auto px-4 py-3 md:py-4">
  <div class="name-header">
    <h1
      class="uppercase tracking-widest text-base md:text-lg font-semibold text-primary10 dark:text-primary70"
    >
      <a class="hidden sm:inline" href="/" aria-label="Go to Home Page"
        >Brett Austin Eastman</a
      >
      <a class="sm:hidden" href="/" aria-label="Go to Home Page"
        >Brett Eastman</a
      >
    </h1>
    <nav class="hidden md:block" aria-label="Main navigation">
      <Navigation />
    </nav>
    <div class="flex justify-end md:hidden">
      <Hamburger />
    </div>
  </div>
  <nav class="md:hidden" aria-label="Mobile navigation">
    <Navigation />
  </nav>
</header>
