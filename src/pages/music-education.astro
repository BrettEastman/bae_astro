---
// Server Side
import { Icon } from "astro-icon/components";
import PageTitle from "../components/PageTitle.astro";
import MainLayout from "../layouts/MainLayout.astro";

const sites = [
  {
    title: "Brett Eastman Studio",
    url: "https://bretteastmanstudio.com/",
    repo: "https://github.com/BrettEastman/bretteastmanstudio",
    description:
      "A free archive of teaching materials \u2014 guitar, bass, and drum transcriptions along with theory handouts \u2014 written or adapted for students over years of teaching. All PDFs are free to download, and a music historian chatbot is built in for asking about the artists and songs you\u2019re learning.",
  },
  {
    title: "Music Cryptogram",
    url: "https://musiccryptogram.app/",
    repo: "https://github.com/BrettEastman/sveltekit-phoneme-notes",
    description:
      "A composition tool that maps letters or phonemes to specific pitches and durations, so text can be transcribed into music. Includes Messiaen\u2019s \u201clangage communicable,\u201d a French phonetic alphabet, and two original alphabets for flute and contraforte.",
  },
  {
    title: "Tone Row Generator",
    url: "https://tone-rows.app/",
    repo: "https://github.com/BrettEastman/twelve-tone",
    description:
      "Enter a tone row on the staff and explore its full matrix \u2014 prime, inversion, retrograde, and retrograde inversion \u2014 in both notation and sound. After the method of Schoenberg, expanded to support rows of 3 to 17 notes.",
  },
];

const aClass =
  "border-b border-primary60 dark:border-primary40 hover:text-accent hover:border-accent transition-colors duration-200";

const pageTitle = "Music Education";
const description =
  "Music theory and education web apps built by Brett Austin Eastman, along with free teaching materials, scores, and books.";
---

<MainLayout title={pageTitle} description={description}>
  <PageTitle title="Music Education" />
  <div class="flex flex-col max-w-5xl m-auto px-2">
    <p class="mb-10 text-lg md:text-xl leading-relaxed">
      A former music teacher, I build web apps for learning and composing with
      music theory. Each one below is free to use and open source. If you are
      looking for printed material instead, my scores and my drum book <em
        >Patterns and Beats</em
      > are available in the <a class={aClass} href="/shop">shop</a>.
    </p>
    <ul
      class="divide-y divide-line dark:divide-lineDark border-t border-b border-line dark:border-lineDark"
    >
      {
        sites.map((site) => (
          <li class="py-6">
            <div class="flex items-baseline justify-between gap-4">
              <a
                class="text-lg md:text-xl font-medium italic text-ink dark:text-primary60 hover:text-accent transition-colors duration-200"
                href={site.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {site.title}
              </a>
              <a
                class="shrink-0 text-primary40 dark:text-primary50 hover:text-accent transition-colors duration-200"
                href={site.repo}
                aria-label={`${site.title} source code on GitHub`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="mdi:github" size={22} />
              </a>
            </div>
            <p class="mt-2 text-primary30 dark:text-primary50 leading-relaxed">
              {site.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</MainLayout>
