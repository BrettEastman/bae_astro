---
// Server Side
import MainLayout from "../layouts/MainLayout.astro";
import PageTitle from "../components/PageTitle.astro";

const works = [
  {
    title: "Internal/External",
    url: "https://youtu.be/s_re25nOkq8",
    instrumentation: "for solo flute and Max MSP electronics",
    year: 2022,
    score: "/shop/score-1",
  },
  {
    title: "Glimmer/Glow",
    url: "https://youtu.be/J451WMaAms8",
    instrumentation: "for two pianists and two percussionists",
    year: 2021,
  },
  {
    title: "How Deep is the Valley",
    url: "https://youtu.be/o5zRH8hLEc0",
    instrumentation: "for piano and Max MSP electronics",
    year: 2020,
  },
  {
    title: "Passover",
    url: "https://youtu.be/1y72j58PL-Y",
    instrumentation: "for solo flute",
    year: 2020,
    score: "/shop/score-5",
  },
  {
    title: "In Response",
    url: "https://youtu.be/HyKHnJb5nfI",
    instrumentation: "for solo flute and fixed media",
    year: 2019,
    score: "/shop/score-7",
  },
  {
    title: "Paraphrase",
    url: "https://youtu.be/CbMFIUBiRjg",
    instrumentation: "for bass clarinet, viola, and piano",
    year: 2019,
    score: "/shop/score-2",
  },
  {
    title: "Keepsake (for Rishi)",
    url: "https://youtu.be/S7T-7jmADfA",
    instrumentation: "for amplified contrabass flute and contraforte",
    year: 2018,
    score: "/shop/score-6",
  },
  {
    title: "La Musique",
    url: "https://youtu.be/ym51ZzgkxN0",
    instrumentation: "for flute and alto flute",
    year: 2017,
    score: "/shop/score-3",
  },
  {
    title: "MISMA",
    url: "https://youtu.be/qX9J_GU7hwI",
    instrumentation: "for violin, clarinet, cello, and piano",
    year: 2017,
    score: "/shop/score-8",
  },
  {
    title: "MAINFRAME",
    url: "https://soundcloud.com/brett-austin-eastman-1/mainframe-movements-4-5-6-7",
    instrumentation: "for string quartet",
    year: 2016,
    score: "/shop/score-4",
  },
];

const pageTitle = "Selected Works";
const description =
  "Here you will find a list of selected classical and new music compositions by Brett Austin Eastman.";
---

<MainLayout title={pageTitle} description={description}>
  <PageTitle title="Selected Works" />
  <div class="flex flex-col max-w-5xl m-auto px-2">
    <ul class="divide-y divide-line dark:divide-lineDark border-t border-b border-line dark:border-lineDark">
      {
        works.map((work) => (
          <li class="group py-5 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
            <span class="text-sm text-primary50 dark:text-primary40 tabular-nums sm:w-14 shrink-0">
              {work.year}
            </span>
            <div class="flex-1">
              <a
                class="text-lg md:text-xl font-medium italic text-ink dark:text-primary60 hover:text-accent transition-colors duration-200"
                href={work.url}
                target="_blank"
              >
                {work.title}
              </a>
              <p class="text-primary40 dark:text-primary50">
                {work.instrumentation}
              </p>
            </div>
            {work.score && (
              <a
                class="text-sm uppercase tracking-wider text-primary40 dark:text-primary50 hover:text-accent transition-colors duration-200 shrink-0"
                href={work.score}
              >
                Score &rarr;
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</MainLayout>
